# Kakao application credentials (https://developers.kakao.com)
KAKAO_REST_API_KEY=your_rest_api_key
KAKAO_CLIENT_SECRET=your_client_secret
KAKAO_REDIRECT_URI=http://localhost:8080/callback
KAKAO_TOKEN_PATH=

# Oracle Cloud Infrastructure Registry (OCIR) for tools/manage.sh
OCI_REGION=ap-seoul-1
OCI_TENANCY_NAMESPACE=your_tenancy_namespace
OCI_USERNAME=oracleidentitycloudservice/you@example.com
OCI_AUTH_TOKEN=your_oci_auth_token
IMAGE_REPOSITORY=kakao-bot
