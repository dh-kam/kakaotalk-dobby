# Kakao application credentials (https://developers.kakao.com)
KAKAO_REST_API_KEY=your_rest_api_key
KAKAO_CLIENT_SECRET=your_client_secret
KAKAO_REDIRECT_URI=http://localhost:8080/callback
KAKAO_TOKEN_PATH=

# Fallback LLM for the skill server (the primary agent uses Vertex AI below).
# Leave AI_PROVIDER unset for auto-detection by available keys
# (gemini > claude > grok > openai > mock).
#AI_PROVIDER=grok
#AI_API_KEY=
#AI_MODEL=grok-4.20-0309-non-reasoning
#AI_BASE_URL=https://api.x.ai/v1

# xAI Grok (https://console.x.ai) — auto-selects the grok provider when no
# higher-priority key (OPENAI/GEMINI/VERTEX/ANTHROPIC) is present.
#XAI_API_KEY=your_xai_api_key

# Google Vertex AI — powers the autonomous agent (tool calling).
#VERTEX_API_KEY=your_vertex_api_key
#VERTEX_PROJECT=
#VERTEX_LOCATION=us-central1
#VERTEX_MODEL=gemini-2.5-flash

# AWS Bedrock — used only by the `kakao-bot agent --provider bedrock` command.
# Kept disabled by default to avoid accidental usage costs.
#AWS_BEARER_TOKEN_BEDROCK=your_bedrock_bearer_token
#AWS_REGION=us-east-1

# Groq Cloud Whisper STT (https://console.groq.com)
# Primary high-speed STT engine under free tier quota.
#GROQ_API_KEY=your_groq_api_key
#STT_ENABLE_FALLBACK=false
#WHISPER_MODEL_PATH=models/ggml-base.bin
#WHISPER_BIN_PATH=whisper-cli

# Admin & Persistence
#KAKAO_ADMIN_TOKEN=your_admin_secret_token
#KAKAO_DATA_DIR=data/schedules

# Oracle Cloud Infrastructure Registry (OCIR) for tools/manage.sh
OCI_REGION=ap-seoul-1
OCI_TENANCY_NAMESPACE=your_tenancy_namespace
OCI_USERNAME=oracleidentitycloudservice/you@example.com
OCI_AUTH_TOKEN=your_oci_auth_token
IMAGE_REPOSITORY=kakaotalk-dobby
